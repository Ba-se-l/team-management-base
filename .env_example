# ==============================================================================
# FastAPI Server Settings
# ==============================================================================
HOST=127.0.0.1
PORT=8000
RELOAD=True
ENVIRONMENT=dev
API_PREFIX=/api/v1

# ==============================================================================
# Database Engine Settings (Async)
# ==============================================================================
# SQLite Dev: sqlite+aiosqlite:///./platform.db
# PostgreSQL Prod: postgresql+asyncpg://postgres:postgres@localhost:5432/team_management
DATABASE_URL=sqlite+aiosqlite:///./platform.db
ECHO=False
AUTO_FLUSH=False
EXPIRE_ON_COMMIT=False
POOL_SIZE=20
MAX_OVERFLOW=10
POOL_TIMEOUT=30
POOL_PRE_PING=True

# ==============================================================================
# Security & JWT Tokens
# ==============================================================================
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
REFRESH_SECRET_KEY=dev-refresh-secret-key-change-in-production-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=False

# ==============================================================================
# CORS & Networking
# ==============================================================================
# Comma-separated or JSON list of origins (e.g. ["http://localhost:3000"])
CORS_ORIGINS=[]
TRUST_PROXY_HEADERS=True
TRUSTED_PROXIES=["127.0.0.1", "::1"]
TRUSTED_PROXY_COUNT=1

# ==============================================================================
# Rate Limiting (Requests per minute)
# ==============================================================================
LOGIN_RATE_LIMIT=5
INQUIRY_RATE_LIMIT=3